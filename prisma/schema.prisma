// Prisma schema — TC CARS
// Base de datos compartida con el flujo de n8n (agendamiento y cotizaciones por WhatsApp).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth / usuarios ----------

enum Role {
  ADMIN
  COLLABORATOR
  CLIENT
}

model User {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String
  role          Role      @default(CLIENT)
  phone         String?
  image         String?
  active        Boolean   @default(true)
  // Datos de staff (solo aplican a ADMIN/COLLABORATOR; quedan null para CLIENT)
  rut           String?   @unique
  position      String?
  birthDate     DateTime?
  startDate     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vehicles                Vehicle[]      @relation("VehicleClient")
  maintenancesAsCollab    Maintenance[]  @relation("MaintenanceCollaborator")
  appointmentsAsClient    Appointment[]  @relation("AppointmentClient")
  appointmentsAsCollab    Appointment[]  @relation("AppointmentCollaborator")

  @@map("users")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}

// ---------- Vehículos y mantenciones ----------

model Vehicle {
  id        String   @id @default(cuid())
  patente   String   @unique
  marca     String
  modelo    String
  anio      Int?
  color     String?
  clientId  String
  client    User     @relation("VehicleClient", fields: [clientId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  maintenances Maintenance[]
  appointments Appointment[]
  quoteRequests QuoteRequest[]

  @@index([clientId])
  @@map("vehicles")
}

enum MaintenanceType {
  MANTENCION
  VISITA_TECNICA
}

enum MaintenanceStatus {
  AGENDADA
  EN_PROCESO
  COMPLETADA
  CANCELADA
}

enum PaymentStatus {
  PENDIENTE
  PAGADO
  PARCIAL
}

model Maintenance {
  id             String            @id @default(cuid())
  folio          Int               @default(autoincrement())
  vehicleId      String
  vehicle        Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type           MaintenanceType   @default(MANTENCION)
  status         MaintenanceStatus @default(AGENDADA)
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  collaboratorId String?
  collaborator   User?             @relation("MaintenanceCollaborator", fields: [collaboratorId], references: [id], onDelete: SetNull)
  description    String
  mileage            Int?
  nextServiceMileage Int?
  laborCost      Decimal           @default(0) @db.Decimal(12, 2)
  partsCost      Decimal           @default(0) @db.Decimal(12, 2)
  additionalCost Decimal           @default(0) @db.Decimal(12, 2)
  totalCost      Decimal           @default(0) @db.Decimal(12, 2)
  paymentStatus  PaymentStatus     @default(PENDIENTE)
  fichaDriveFileId String?
  fichaUrl         String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  images        MaintenanceImage[]
  quoteRequests QuoteRequest[]

  @@index([vehicleId])
  @@index([collaboratorId])
  @@map("maintenances")
}

model MaintenanceImage {
  id            String      @id @default(cuid())
  maintenanceId String
  maintenance   Maintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  url           String
  uploadedAt    DateTime    @default(now())

  @@index([maintenanceId])
  @@map("maintenance_images")
}

// ---------- Agendamiento / calendario ----------

enum AppointmentSource {
  WEB
  WHATSAPP_N8N
}

enum AppointmentStatus {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
}

model Appointment {
  id             String            @id @default(cuid())
  source         AppointmentSource @default(WEB)
  vehicleId      String?
  vehicle        Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  clientId       String?
  client         User?             @relation("AppointmentClient", fields: [clientId], references: [id], onDelete: SetNull)
  collaboratorId String?
  collaborator   User?             @relation("AppointmentCollaborator", fields: [collaboratorId], references: [id], onDelete: SetNull)
  scheduledAt    DateTime
  contactName    String
  contactPhone   String
  notes          String?
  status         AppointmentStatus @default(PENDIENTE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([scheduledAt])
  @@index([collaboratorId])
  @@map("appointments")
}

/**
 * Horario de atención del taller, editable por el ADMIN en /admin/horario.
 * Una fila por día de la semana (dayOfWeek: 0=domingo ... 6=sábado, mismo
 * criterio que Date.getDay()). Se usa para no ofrecer/aceptar horas de
 * agendamiento fuera de horario, sobre todo en el flujo de WhatsApp donde
 * nadie humano revisa antes de confirmarle la hora al cliente.
 */
model BusinessHours {
  dayOfWeek Int      @id
  isOpen    Boolean  @default(true)
  openTime  String   @default("09:00")
  closeTime String   @default("18:00")
  updatedAt DateTime @updatedAt

  @@map("business_hours")
}

// ---------- Catálogo público ----------

/**
 * Sección "destacado" en grande en la landing (producto o servicio nuevo que
 * el admin quiere resaltar temporalmente). Solo se muestra el más reciente
 * con active=true; el admin edita uno a la vez desde /admin/destacado.
 */
model Highlight {
  id          String   @id @default(cuid())
  title       String
  description String
  imageUrl    String?
  ctaLabel    String   @default("Ver más")
  ctaHref     String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("highlights")
}

model ServicePost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  imageUrl    String?
  order       Int      @default(0)
  published   Boolean  @default(true)
  // Solo un servicio puede ser el "estrella" a la vez — se resalta en grande
  // en la portada y con una insignia en el catálogo. Ver ServicePost.service.ts.
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("service_posts")
}

/**
 * Testimonio/reseña de un cliente, administrable desde /admin/referencias.
 * Se muestra en una sección de la portada con foto (opcional) y comentario.
 */
model Reference {
  id         String   @id @default(cuid())
  authorName String
  comment    String
  imageUrl   String?
  order      Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("references")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  price       Decimal  @db.Decimal(12, 2)
  imageUrl    String?
  stock       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}

enum ContactStatus {
  NUEVO
  LEIDO
  RESPONDIDO
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  status    ContactStatus @default(NUEVO)
  createdAt DateTime      @default(now())

  @@map("contact_messages")
}

// ---------- Proveedores y cotizaciones (contrato con n8n) ----------

model Supplier {
  id        String   @id @default(cuid())
  name      String
  email     String
  specialty String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quoteResponses QuoteResponse[]

  @@map("suppliers")
}

enum QuoteRequestStatus {
  ENVIADA
  RESPONDIDA
  SELECCIONADA
  CANCELADA
}

model QuoteRequest {
  id             String             @id @default(cuid())
  vehicleId      String?
  vehicle        Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  maintenanceId  String?
  maintenance    Maintenance?       @relation(fields: [maintenanceId], references: [id], onDelete: SetNull)
  requestedItems Json
  status         QuoteRequestStatus @default(ENVIADA)
  createdAt      DateTime           @default(now())

  responses QuoteResponse[]

  @@map("quote_requests")
}

model QuoteResponse {
  id             String       @id @default(cuid())
  quoteRequestId String
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  amount         Decimal      @db.Decimal(12, 2)
  receivedAt     DateTime     @default(now())
  selected       Boolean      @default(false)
  notes          String?

  @@index([quoteRequestId])
  @@map("quote_responses")
}
